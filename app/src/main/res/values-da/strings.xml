    <string name="htp_goal">Mål</string>
    <string name="htp_goal_body">Skub brikkerne for at smelte ens tal sammen og lave %1$s-brikken. På et 3×3-bræt er målet %2$s.</string>
    <string name="htp_moving">Flytning</string>
    <string name="htp_moving_body">Stryg op, ned, til venstre eller til højre. Hver brik glider så langt, den kan, i den retning.</string>
    <string name="htp_merging">Sammensmeltning</string>
    <string name="htp_merging_body">To brikker med samme tal, der rører hinanden, smelter sammen til én brik med deres sum. En brik smelter kun sammen én gang pr. træk.</string>
    <string name="htp_merging_illustration_cd">Eksempel: 2, 2, 2, 2 flyttet til venstre bliver til 4, 4</string>
    <string name="htp_new_tiles">Nye brikker</string>
    <string name="htp_new_tiles_body">Efter hvert træk, der ændrer brættet, dukker en ny brik op i et tilfældigt tomt felt: en 2\'er ni ud af ti gange, ellers en 4\'er.</string>
    <string name="htp_board_sizes">Brætstørrelser</string>
    <string name="htp_board_sizes_body">Hver størrelse har sit eget spil, sin egen bedste score og sin egen statistik.</string>
    <string name="htp_undo">Fortrydelse</string>
    <string name="htp_undo_body">Fortryd er ubegrænset og virker også, når spillet er slut. Fortryd giver den samme næste brik igen, så et gentaget træk giver det samme resultat. Fortrydelser tælles, og spil med fortryd tæller ikke med i »Bedste uden fortryd«.</string>
    <string name="htp_keys">Tastatur og controllere</string>
    <string name="htp_key_move">Flyt</string>
    <string name="htp_key_move_keys">Piletaster · W A S D · H J K L · D-pad</string>
    <string name="htp_key_undo_keys">U · Ctrl+Z · Backspace</string>
    <string name="htp_key_new_game_keys">N · R (spørger først, hvis et spil er i gang)</string>
    <string name="htp_accessibility_body">Når TalkBack er slået til, vises retningsknapper under brættet, og brættet tilbyder Flyt, Fortryd og Nyt spil i TalkBacks handlingsmenu.</string>
