    <string name="htp_key_move_keys">Touches fléchées · W A S D · H J K L · croix directionnelle</string>
    <string name="htp_key_undo_keys">U · Ctrl+Z · Retour arrière</string>
    <string name="htp_key_new_game_keys">N · R (demande confirmation si une partie est en cours)</string>
    <string name="htp_accessibility_body">Quand TalkBack est activé, un pavé directionnel apparaît sous la grille, et la grille propose Déplacer, Annuler et Nouvelle partie dans le menu des actions de TalkBack.</string>
