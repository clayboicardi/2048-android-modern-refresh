    <string name="about_privacy">Privacy</string>
    <string name="privacy_text">Deze app verzamelt niets. De app heeft geen netwerktoegang, geen accounts, geen advertenties en geen gebruiksanalyse. Spelgegevens blijven op je apparaat. De eigen back-up van Android kan ze naar je Google-account kopiëren als je apparaatback-up hebt aangezet.</string>
