    <string name="htp_goal">Cél</string>
    <string name="htp_goal_body">Csúsztassa a lapkákat, hogy az egyforma számok összeolvadjanak, és hozza létre a %1$s értékű lapkát. A 3×3-as táblán a cél %2$s.</string>
    <string name="htp_moving">Mozgatás</string>
    <string name="htp_moving_body">Csúsztassa az ujját felfelé, lefelé, balra vagy jobbra. Minden lapka olyan messzire csúszik abba az irányba, amennyire csak tud.</string>
    <string name="htp_merging">Összeolvadás</string>
    <string name="htp_merging_body">Két egymás melletti, azonos számú lapka egyetlen lapkává olvad össze, amelynek értéke a kettő összege. Egy lapka lépésenként csak egyszer olvadhat össze.</string>
    <string name="htp_merging_illustration_cd">Példa: a 2, 2, 2, 2 balra mozgatva 4, 4 lesz</string>
    <string name="htp_new_tiles">Új lapkák</string>
    <string name="htp_new_tiles_body">Minden olyan lépés után, amely megváltoztatja a táblát, egy új lapka jelenik meg egy véletlenszerű üres mezőn: tízből kilencszer 2-es, egyébként 4-es.</string>
    <string name="htp_board_sizes">Táblaméretek</string>
    <string name="htp_board_sizes_body">Minden méretnek saját játéka, rekordja és statisztikája van.</string>
    <string name="htp_undo">Visszavonás</string>
    <string name="htp_undo_body">A visszavonás korlátlan, és a játék vége után is használható. A visszavonás ugyanazt a következő lapkát hozza vissza, így egy lépés megismétlése ugyanazt az eredményt adja. A visszavonásokat a játék számolja, és a visszavonással játszott játékok nem számítanak bele a „Rekord visszavonás nélkül” statisztikába.</string>
    <string name="htp_keys">Billentyűzet és kontrollerek</string>
    <string name="htp_key_move">Mozgatás</string>
    <string name="htp_key_move_keys">Nyílbillentyűk · W A S D · H J K L · D-pad</string>
    <string name="htp_key_undo_keys">U · Ctrl+Z · Backspace</string>
    <string name="htp_key_new_game_keys">N · R (folyamatban lévő játéknál előbb rákérdez)</string>
    <string name="htp_accessibility_body">Ha a TalkBack be van kapcsolva, a tábla alatt iránygombok jelennek meg, a tábla pedig a TalkBack műveletmenüjében felkínálja a Mozgatás, a Visszavonás és az Új játék műveletet.</string>
