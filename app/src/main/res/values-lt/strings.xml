    <string name="htp_key_move_keys">Rodyklės · W A S D · H J K L · D-pad</string>
    <string name="htp_key_undo_keys">U · Ctrl+Z · Backspace</string>
    <string name="htp_key_new_game_keys">N · R (jei žaidimas nebaigtas, pirma paklausia)</string>
    <string name="htp_accessibility_body">Kai TalkBack įjungtas, po lenta atsiranda krypčių valdiklis, o TalkBack veiksmų meniu lenta siūlo veiksmus Pastumti, Atšaukti ėjimą ir Naujas žaidimas.</string>
