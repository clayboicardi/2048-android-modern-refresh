    <string name="how_to_play">Πώς παίζεται</string>
    <string name="htp_goal">Στόχος</string>
    <string name="htp_goal_body">Σύρετε τα πλακίδια για να συγχωνεύσετε ίδιους αριθμούς και να φτιάξετε το πλακίδιο %1$s. Σε ταμπλό 3×3 ο στόχος είναι το %2$s.</string>
    <string name="htp_moving">Μετακίνηση</string>
    <string name="htp_moving_body">Σύρετε πάνω, κάτω, αριστερά ή δεξιά. Κάθε πλακίδιο γλιστρά όσο πιο μακριά μπορεί προς αυτή την κατεύθυνση.</string>
    <string name="htp_merging">Συγχώνευση</string>
    <string name="htp_merging_body">Δύο γειτονικά πλακίδια με τον ίδιο αριθμό συγχωνεύονται σε ένα πλακίδιο με το άθροισμά τους. Ένα πλακίδιο συγχωνεύεται μόνο μία φορά ανά κίνηση.</string>
    <string name="htp_merging_illustration_cd">Παράδειγμα: 2, 2, 2, 2 με μετακίνηση αριστερά γίνεται 4, 4</string>
    <string name="htp_new_tiles">Νέα πλακίδια</string>
    <string name="htp_new_tiles_body">Μετά από κάθε κίνηση που αλλάζει το ταμπλό, εμφανίζεται ένα νέο πλακίδιο σε τυχαίο κενό κελί: ένα 2 εννέα φορές στις δέκα, αλλιώς ένα 4.</string>
    <string name="htp_board_sizes">Μεγέθη ταμπλό</string>
    <string name="htp_board_sizes_body">Κάθε μέγεθος έχει το δικό του παιχνίδι, ρεκόρ και στατιστικά.</string>
    <string name="htp_undo">Αναίρεση</string>
    <string name="htp_undo_body">Η αναίρεση είναι απεριόριστη και λειτουργεί και μετά το τέλος του παιχνιδιού. Η αναίρεση φέρνει πίσω το ίδιο επόμενο πλακίδιο, οπότε η επανάληψη μιας κίνησης δίνει το ίδιο αποτέλεσμα. Οι αναιρέσεις μετρώνται και τα παιχνίδια με αναίρεση δεν μετράνε για το «Ρεκόρ χωρίς αναίρεση».</string>
    <string name="htp_keys">Πληκτρολόγιο και χειριστήρια</string>
    <string name="htp_key_move">Μετακίνηση</string>
    <string name="htp_key_move_keys">Πλήκτρα βέλους · W A S D · H J K L · σταυρός κατεύθυνσης</string>
    <string name="htp_key_undo_keys">U · Ctrl+Z · Backspace</string>
    <string name="htp_key_new_game_keys">N · R (ζητά πρώτα επιβεβαίωση όσο ένα παιχνίδι είναι σε εξέλιξη)</string>
    <string name="htp_accessibility_body">Με ενεργό το TalkBack, εμφανίζονται κουμπιά κατεύθυνσης κάτω από το ταμπλό και το ταμπλό προσφέρει τις ενέργειες «Μετακίνηση», «Αναίρεση» και «Νέο παιχνίδι» στο μενού ενεργειών του TalkBack.</string>
