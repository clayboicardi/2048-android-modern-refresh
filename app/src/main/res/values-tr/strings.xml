    <string name="htp_key_undo_keys">U · Ctrl+Z · Backspace</string>
    <string name="htp_key_new_game_keys">N · R (oyun devam ederken önce sorar)</string>
    <string name="htp_accessibility_body">TalkBack açıkken tahtanın altında yön düğmeleri belirir ve tahta, TalkBack işlemler menüsünde Kaydır, Geri al ve Yeni oyun seçeneklerini sunar.</string>
