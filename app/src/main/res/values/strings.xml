    <string name="sensitivity_medium">Medium</string>
    <!-- Value. -->
    <string name="sensitivity_high">High</string>
    <!-- Supporting line under "Low". -->
    <string name="sensitivity_low_detail">Needs a longer swipe</string>
    <!-- Supporting line under "Medium". -->
    <string name="sensitivity_medium_detail">Recommended</string>
    <!-- Supporting line under "High". -->
    <string name="sensitivity_high_detail">Reacts to short swipes</string>
    <!-- Section header. -->
    <string name="settings_section_display">Display</string>
    <!-- Switch row that hides the status and navigation bars. Seeded from the legacy "full screen" nouns (glossary). -->
