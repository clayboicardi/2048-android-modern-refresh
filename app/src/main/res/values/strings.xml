    <!-- H. How to play -->
    <!-- Title of the rules screen. -->
    <string name="how_to_play">How to play</string>
    <!-- Section heading (noun). -->
    <string name="htp_goal">Goal</string>
    <!-- Keep "3×3" exactly (Latin digits, U+00D7). Arguments: %1$s = "2048"; %2$s = "256" -->
    <string name="htp_goal_body">Slide the tiles to merge equal numbers and build the %1$s tile. On a 3×3 board the goal is %2$s.</string>
    <!-- Section heading (noun or gerund). -->
    <string name="htp_moving">Moving</string>
    <!-- Body of the How to play section "Moving". -->
    <string name="htp_moving_body">Swipe up, down, left or right. Every tile slides as far as it can in that direction.</string>
    <!-- Section heading. -->
    <string name="htp_merging">Merging</string>
    <!-- Body of the How to play section "Merging". -->
    <string name="htp_merging_body">Two touching tiles with the same number merge into one tile with their sum. A tile merges only once per move.</string>
    <!-- Spoken description of the left-to-right example picture. Keep the digits and their order. -->
    <string name="htp_merging_illustration_cd">Example: 2, 2, 2, 2 moved left becomes 4, 4</string>
    <!-- Section heading. -->
    <string name="htp_new_tiles">New tiles</string>
    <!-- "2" and "4" are tile values: keep them as Latin digits. "nine times out of ten" is written in words. -->
    <string name="htp_new_tiles_body">After every move that changes the board, a new tile appears in a random empty cell: a 2 nine times out of ten, otherwise a 4.</string>
    <!-- Section heading. -->
    <string name="htp_board_sizes">Board sizes</string>
    <!-- Body of the How to play section "Board sizes", below the table of sizes and goals. -->
    <string name="htp_board_sizes_body">Each size keeps its own game, best score and statistics.</string>
    <!-- Section heading (noun; may differ from the `undo` button verb). -->
    <string name="htp_undo">Undo</string>
    <!-- "Best without undo" is the statistic name; match `stats_best_no_undo`. -->
    <string name="htp_undo_body">Undo is unlimited and also works after game over. Undo brings back the same next tile, so repeating a move gives the same result. Undos are counted, and games with undo don\'t count toward Best without undo.</string>
    <!-- Section heading for the key table. -->
    <string name="htp_keys">Keyboard and controllers</string>
    <!-- Key-table label: the keys that move tiles. Verb. -->
    <string name="htp_key_move">Move</string>
    <!-- Translate only "Arrow keys" and "D-pad". Keep the letters, spaces and " · " separators. -->
    <string name="htp_key_move_keys">Arrow keys · W A S D · H J K L · D-pad</string>
    <!-- Translate only the key name "Backspace" if your keyboards label it differently; keep "U" and "Ctrl+Z". -->
    <string name="htp_key_undo_keys">U · Ctrl+Z · Backspace</string>
    <!-- Keep "N · R"; translate the parenthesis. -->
    <string name="htp_key_new_game_keys">N · R (asks first while a game is in progress)</string>
    <!-- Section heading: Android's screen reader. Product name. -->
    <string name="htp_accessibility" translatable="false">TalkBack</string>
    <!-- Keep "TalkBack". Use the same words as `htp_key_move`, `undo` and `new_game` for the three actions. -->
    <string name="htp_accessibility_body">With TalkBack on, a direction pad appears below the board, and the board offers Move, Undo and New game in the TalkBack actions menu.</string>

    <!-- I. About, Licenses, What's new -->
    <!-- Title of the About screen. -->
    <string name="about">About</string>
    <!-- Version line, e.g. "Version 1.0.0 (10000)". Arguments: %1$s = versionName; %2$s = versionCode (Latin digits) -->
    <string name="about_version">Version %1$s (%2$s)</string>
    <!-- Section heading listing every release of this app. -->
    <string name="about_whats_new">What\'s new</string>
    <!-- Row that opens the GitHub repository. -->
    <string name="about_source_code">Source code</string>
    <!-- Supporting text of the source row. -->
    <string name="about_source_code_url" translatable="false">github.com/clayboicardi/2048-android-modern-refresh</string>
    <!-- Section heading. -->
    <string name="about_privacy">Privacy</string>
