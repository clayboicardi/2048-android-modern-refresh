    <string name="htp_goal">Cíl</string>
    <string name="htp_goal_body">Posouvejte dlaždice, spojujte stejná čísla a vytvořte dlaždici %1$s. Na ploše 3×3 je cílem %2$s.</string>
    <string name="htp_moving">Pohyb</string>
    <string name="htp_moving_body">Přejeďte prstem nahoru, dolů, doleva nebo doprava. Každá dlaždice se posune tímto směrem tak daleko, jak to jde.</string>
    <string name="htp_merging">Spojování</string>
    <string name="htp_merging_body">Dvě sousední dlaždice se stejným číslem se spojí v jednu dlaždici s jejich součtem. Dlaždice se během jednoho tahu spojí jen jednou.</string>
    <string name="htp_merging_illustration_cd">Příklad: 2, 2, 2, 2 po posunutí doleva dá 4, 4</string>
    <string name="htp_new_tiles">Nové dlaždice</string>
    <string name="htp_new_tiles_body">Po každém tahu, který změní hrací plochu, se na náhodném prázdném poli objeví nová dlaždice: v devíti případech z deseti 2, jinak 4.</string>
    <string name="htp_board_sizes">Velikosti plochy</string>
    <string name="htp_board_sizes_body">Každá velikost má vlastní hru, nejlepší skóre a statistiky.</string>
    <string name="htp_undo">Vracení tahů</string>
    <string name="htp_undo_body">Vracení tahů je neomezené a funguje i po konci hry. Vrácení tahu přinese stejnou další dlaždici, takže opakovaný tah dá stejný výsledek. Každé vrácení tahu se počítá a hry s vrácením tahu se nezapočítávají do „Nejlepší bez vracení“.</string>
    <string name="htp_keys">Klávesnice a ovladače</string>
    <string name="htp_key_move">Posunout</string>
    <string name="htp_key_move_keys">Šipky · W A S D · H J K L · D-pad</string>
    <string name="htp_key_undo_keys">U · Ctrl+Z · Backspace</string>
    <string name="htp_key_new_game_keys">N · R (během rozehrané hry se nejdřív zeptá)</string>
    <string name="htp_accessibility_body">Když je zapnutý TalkBack, pod hrací plochou se zobrazí směrový ovladač a hrací plocha nabízí v nabídce akcí TalkBack možnosti Posunout, Vrátit tah a Nová hra.</string>
