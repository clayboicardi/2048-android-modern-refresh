    <string name="htp_key_move_keys">Sagoklavoj · W A S D · H J K L · D-pad</string>
    <string name="htp_key_undo_keys">U · Ctrl+Z · Retropaŝo</string>
    <string name="htp_key_new_game_keys">N · R (unue demandas, se ludo daŭras)</string>
    <string name="htp_accessibility_body">Kiam TalkBack estas ŝaltita, direktobutonaro aperas sub la tabulo, kaj la tabulo proponas Movi, Malfari kaj Nova ludo en la menuo de agoj de TalkBack.</string>
